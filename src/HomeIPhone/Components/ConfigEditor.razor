<section><h2>Identity</h2><div class="formgrid"><label>Friendly name<input @bind:event="oninput" @bind="Configuration.FriendlyName" maxlength="120" /></label><label>Description<input @bind:event="oninput" @bind="Configuration.Description" maxlength="512" /></label><label>Location<input @bind:event="oninput" @bind="Configuration.Location" maxlength="120" /></label><label>Model<select @bind="Configuration.Model"><option>Unknown</option><option>Cisco 7945G</option><option>Cisco 7965G</option></select></label></div></section>
<section><h2>Server URLs</h2><div class="formgrid"><label>Services URL<input @bind:event="oninput" @bind="Configuration.ServicesUrl" /></label><label>Directory URL<input @bind:event="oninput" @bind="Configuration.DirectoryUrl" /></label><label>Idle URL<input @bind:event="oninput" @bind="Configuration.IdleUrl" /></label><label>Information URL<input @bind:event="oninput" @bind="Configuration.InformationUrl" /></label><label>Messages URL<input @bind:event="oninput" @bind="Configuration.MessagesUrl" /></label></div></section>
<section><h2>Device settings</h2><div class="formgrid"><label>NTP server<input @bind:event="oninput" @bind="Configuration.NtpServer" /></label><label>Cisco timezone<input @bind:event="oninput" @bind="Configuration.TimeZone" /></label><label>Date template<input @bind:event="oninput" @bind="Configuration.DateTemplate" /></label><label>Firmware load (optional)<input @bind:event="oninput" @bind="Configuration.FirmwareLoad" /></label><label><input type="checkbox" @bind="Configuration.WebAccess" /> Web access enabled</label><label><input type="checkbox" @bind="Configuration.SshAccess" /> SSH enabled</label></div></section>
<section><h2>Advanced XML override</h2><p class="muted">Optional full device XML. Replaces the structured settings in the served file. Clear it to return to generated configuration.</p><label>Raw full-file override<textarea @bind:event="oninput" rows="12" @bind="Configuration.RawOverrideXml" spellcheck="false"></textarea></label><button disabled="@Busy" @onclick="() => Save.InvokeAsync()">Save configuration</button></section>
@code {
    [Parameter, EditorRequired] public PhoneConfiguration Configuration { get; set; } = new();
    [Parameter] public EventCallback Save { get; set; }
    [Parameter] public bool Busy { get; set; }
}
